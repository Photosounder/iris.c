#version 450
#extension GL_KHR_shader_subgroup_arithmetic : require
layout(local_size_x = 32) in;
layout(set = 0, binding = 0, std430) buffer XBuffer { uint x[]; };
layout(set = 0, binding = 1, std430) readonly buffer WeightBuffer { uint weight[]; };
layout(push_constant) uniform Push { uint p[4]; } pc;
float decode_bf16(uint packed, uint index) {
    uint bits = (index & 1u) == 0u ? packed & 0xffffu : packed >> 16u;
    return uintBitsToFloat(bits << 16u);
}
uint encode_bf16(float value) {
    uint bits = floatBitsToUint(value); bits += 0x7fffu + ((bits >> 16u) & 1u); return bits >> 16u;
}
void main() {
    // Normalize one attention head with a subgroup
    uint lane = gl_LocalInvocationID.x;
    uint group = gl_WorkGroupID.x;
    uint heads = pc.p[1];
    uint head_dim = pc.p[2];
    uint head = group - (group / heads) * heads;
    uint base = (group / heads) * heads * head_dim + head * head_dim;
    float sum = 0.0;
    for (uint d = lane; d < head_dim; d += 32u) { float value = decode_bf16(x[(base + d) >> 1u], base + d); sum += value * value; }
    float inv = inversesqrt(subgroupAdd(sum) / float(head_dim) + uintBitsToFloat(pc.p[3]));
    for (uint pair = lane; pair * 2u < head_dim; pair += 32u) {
        uint d = pair * 2u;
        uint low = encode_bf16(decode_bf16(x[(base + d) >> 1u], base + d) * inv * decode_bf16(weight[d >> 1u], d));
        uint high = d + 1u < head_dim ? encode_bf16(decode_bf16(x[(base + d + 1u) >> 1u], base + d + 1u) * inv * decode_bf16(weight[(d + 1u) >> 1u], d + 1u)) : 0u;
        x[(base + d) >> 1u] = low | (high << 16u);
    }
}
