#version 450
#extension GL_KHR_shader_subgroup_arithmetic : require
layout(local_size_x = 32) in;
layout(set = 0, binding = 0, std430) readonly buffer XBuffer { uint x[]; };
layout(set = 0, binding = 1, std430) readonly buffer WeightBuffer { uint weight[]; };
layout(set = 0, binding = 2, std430) buffer OutputBuffer { uint output_data[]; };
layout(push_constant) uniform Push { uint p[3]; } pc;

float decode_bf16(uint packed, uint index) {
    uint bits = (index & 1u) == 0u ? packed & 0xffffu : packed >> 16u;
    return uintBitsToFloat(bits << 16u);
}
uint encode_bf16(float value) {
    uint bits = floatBitsToUint(value);
    bits += 0x7fffu + ((bits >> 16u) & 1u);
    return bits >> 16u;
}
void main() {
    // Reduce one sequence row with a subgroup
    uint lane = gl_LocalInvocationID.x;
    uint row = gl_WorkGroupID.x;
    uint hidden = pc.p[1];
    float sum = 0.0;
    for (uint index = lane; index < hidden; index += 32u) {
        float value = decode_bf16(x[(row * hidden + index) >> 1u], row * hidden + index);
        sum += value * value;
    }
    float inverse_rms = inversesqrt(subgroupAdd(sum) / float(hidden) + uintBitsToFloat(pc.p[2]));
    for (uint pair = lane; pair * 2u < hidden; pair += 32u) {
        uint index = pair * 2u;
        uint base = row * hidden + index;
        uint low = encode_bf16(decode_bf16(x[base >> 1u], base) * inverse_rms * decode_bf16(weight[index >> 1u], index));
        uint high = index + 1u < hidden
            ? encode_bf16(decode_bf16(x[(base + 1u) >> 1u], base + 1u) * inverse_rms * decode_bf16(weight[(index + 1u) >> 1u], index + 1u)) : 0u;
        output_data[base >> 1u] = low | (high << 16u);
    }
}
