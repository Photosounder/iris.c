#version 450
layout(local_size_x = 256) in;
layout(set = 0, binding = 0, std430) readonly buffer InputBuffer { float input_data[]; };
layout(set = 0, binding = 1, std430) buffer OutputBuffer { uint output_data[]; };
layout(push_constant) uniform Push { uint p[1]; } pc;

uint encode_bf16(float value) {
    uint bits = floatBitsToUint(value);
    bits += 0x7fffu + ((bits >> 16u) & 1u);
    return bits >> 16u;
}

void main() {
    // Convert and pack two FP32 values into each storage word
    uint pair = gl_GlobalInvocationID.x;
    uint index = pair * 2u;
    if (index >= pc.p[0]) return;
    uint low = encode_bf16(input_data[index]);
    uint high = index + 1u < pc.p[0] ? encode_bf16(input_data[index + 1u]) : 0u;
    output_data[pair] = low | (high << 16u);
}
