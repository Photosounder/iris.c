#version 450

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) buffer GateBuffer { float gate[]; };
layout(set = 0, binding = 1, std430) readonly buffer UpBuffer { float up[]; };

layout(push_constant) uniform Push { uint p[1]; } pc;

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= pc.p[0]) return;
    float x = gate[index];
    gate[index] = (x / (1.0 + exp(-x))) * up[index];
}
