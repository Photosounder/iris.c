#version 450

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) buffer QBuffer { float q[]; };
layout(set = 0, binding = 1, std430) buffer KBuffer { float k[]; };
layout(set = 0, binding = 2, std430) readonly buffer CosBuffer { float cos_freq[]; };
layout(set = 0, binding = 3, std430) readonly buffer SinBuffer { float sin_freq[]; };

layout(push_constant) uniform Push { uint p[3]; } pc;

void main() {
    uint pair = gl_GlobalInvocationID.x;
    uint seq = pc.p[0];
    uint heads = pc.p[1];
    uint head_dim = pc.p[2];
    uint pairs_per_head = head_dim / 2u;
    uint total_pairs = seq * heads * pairs_per_head;
    if (pair >= total_pairs) return;

    uint position = pair / (heads * pairs_per_head);
    uint rem = pair - position * heads * pairs_per_head;
    uint head = rem / pairs_per_head;
    uint pair_in_head = rem - head * pairs_per_head;
    uint base = position * heads * head_dim + head * head_dim + pair_in_head * 2u;
    float c = cos_freq[position * head_dim + pair_in_head * 2u];
    float s = sin_freq[position * head_dim + pair_in_head * 2u];

    float q0 = q[base];
    float q1 = q[base + 1u];
    float k0 = k[base];
    float k1 = k[base + 1u];
    q[base] = q0 * c - q1 * s;
    q[base + 1u] = q0 * s + q1 * c;
    k[base] = k0 * c - k1 * s;
    k[base + 1u] = k0 * s + k1 * c;
}
