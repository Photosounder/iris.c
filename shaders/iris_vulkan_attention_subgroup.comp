#version 450

#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

#define QUERY_TILE 8u
#define KEY_TILE 16u
#define MAX_HEAD_DIM 128u

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer QBuffer { float q[]; };
layout(set = 0, binding = 1, std430) readonly buffer KBuffer { float k[]; };
layout(set = 0, binding = 2, std430) readonly buffer VBuffer { float v[]; };
layout(set = 0, binding = 3, std430) buffer OutputBuffer { float output_data[]; };

layout(push_constant) uniform Push { uint p[6]; } pc;

shared float key_tile[KEY_TILE * MAX_HEAD_DIM];
shared float value_tile[KEY_TILE * MAX_HEAD_DIM];

void main() {
    // Assign one query to each subgroup and four head components to each lane
    uint local_index = gl_LocalInvocationID.x;
    uint lane = gl_SubgroupInvocationID;
    uint query_in_tile = gl_SubgroupID;
    uint group = gl_WorkGroupID.x;
    uint seq_q = pc.p[0];
    uint seq_k = pc.p[1];
    uint heads = pc.p[2];
    uint head_dim = pc.p[3];
    uint hidden = heads * head_dim;
    uint query_block = group / heads;
    uint head = group - query_block * heads;
    uint query = pc.p[5] + query_block * QUERY_TILE + query_in_tile;
    uint component = lane * 4u;
    float scale = uintBitsToFloat(pc.p[4]);
    bool valid_query = query < seq_q && query_in_tile < QUERY_TILE;

    // Keep the query and online-softmax state in registers
    uint query_base = query * hidden + head * head_dim;
    float query_values[4];
    float accumulated[4];
    for (uint part = 0u; part < 4u; part++) {
        uint index = component + part;
        query_values[part] = valid_query && index < head_dim
            ? q[query_base + index] : 0.0;
        accumulated[part] = 0.0;
    }
    float maximum = -3.402823466e+38;
    float denominator = 0.0;

    // Load each K/V tile once and reuse it for eight neighboring queries
    for (uint key_start = 0u; key_start < seq_k; key_start += KEY_TILE) {
        for (uint linear = local_index;
             linear < KEY_TILE * MAX_HEAD_DIM;
             linear += gl_WorkGroupSize.x) {
            uint key_in_tile = linear / MAX_HEAD_DIM;
            uint dimension = linear - key_in_tile * MAX_HEAD_DIM;
            uint key = key_start + key_in_tile;
            float key_value = 0.0;
            float value = 0.0;
            if (key < seq_k && dimension < head_dim) {
                uint source = key * hidden + head * head_dim + dimension;
                key_value = k[source];
                value = v[source];
            }
            key_tile[linear] = key_value;
            value_tile[linear] = value;
        }
        barrier();

        // Update eight independent online softmax reductions from the shared tile
        uint available = min(KEY_TILE, seq_k - key_start);
        for (uint key_in_tile = 0u; key_in_tile < available; key_in_tile++) {
            float partial_dot = 0.0;
            for (uint part = 0u; part < 4u; part++) {
                uint index = component + part;
                if (valid_query && index < head_dim)
                    partial_dot += query_values[part] *
                        key_tile[key_in_tile * MAX_HEAD_DIM + index];
            }
            float scaled_score = subgroupAdd(partial_dot) * scale;
            float new_maximum = max(maximum, scaled_score);
            float rescale = exp(maximum - new_maximum);
            float probability = exp(scaled_score - new_maximum);
            denominator = denominator * rescale + probability;
            maximum = new_maximum;
            for (uint part = 0u; part < 4u; part++) {
                uint index = component + part;
                if (valid_query && index < head_dim) {
                    accumulated[part] = accumulated[part] * rescale + probability *
                        value_tile[key_in_tile * MAX_HEAD_DIM + index];
                }
            }
        }
        barrier();
    }

    // Normalize and store each subgroup's output query
    if (valid_query) {
        for (uint part = 0u; part < 4u; part++) {
            uint index = component + part;
            if (index < head_dim)
                output_data[query_base + index] = accumulated[part] / denominator;
        }
    }
}
